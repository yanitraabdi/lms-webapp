{
  "name": "lms-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-icons.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:api": "openapi-typescript http://localhost:8080/openapi/v1.json -o api-client/schema.ts",
    "e2e:up": "docker compose -p inverta-e2e --env-file ../e2e.env -f ../docker-compose.yml -f ../docker-compose.e2e.yml down -v && docker compose -p inverta-e2e --env-file ../e2e.env -f ../docker-compose.yml -f ../docker-compose.e2e.yml up -d --build",
    "e2e:down": "docker compose -p inverta-e2e --env-file ../e2e.env -f ../docker-compose.yml -f ../docker-compose.e2e.yml down -v",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "driver.js": "^1.3.1",
    "hls.js": "^1.6.16",
    "next": "15.1.6",
    "next-intl": "^3.26.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "openapi-typescript": "^7.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
